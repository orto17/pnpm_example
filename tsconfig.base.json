{
    "compilerOptions": {
        "esModuleInterop": true,
        "importHelpers": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "CommonJS",
        "target": "es2022",
        "moduleResolution": "node",
        "sourceMap": true,
        "declaration": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "alwaysStrict": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "exclude": [
        "dist",
        "temp",
        "node_modules",
        "cdk.out"
    ],
}