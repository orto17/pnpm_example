{
    "name": "@sample-backend/HelloDynamo",
    "version": "0.0.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist/*"
    ],
    "publishConfig": {
        "access": "restricted"
    },
    "scripts": {
        "clean:dist": "rimraf dist",
        "compile": "tsc --noEmit && esbuild src/index.ts --platform=node --external:@aws-sdk/\"*\" --bundle --outdir=./dist",
        "build": "pnpm run clean:dist && pnpm run compile",
        "test": "jest --coverage",
        "test:watch": "jest --coverage --watch",
        "test:ci": "jest",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "prepublishOnly": "pnpm run build"
    },
    "devDependencies": {
        "@aws-sdk/client-dynamodb": "^3.876.0",
        "@aws-sdk/types": "^3.862.0",
        "@types/jest": "^30.0.0",
        "jest": "^30.1.1",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    }
}