{
    "name": "sample-be",
    "scripts": {
        "package:add": "hygen package new",
        "lint": "eslint \"**/*.{ts,tsx,js,jsx,yml}\"",
        "lint:check": "pnpm run lint",
        "lint:fix": "pnpm run lint --fix",
        "build": "lerna run build",
        "test": "lerna run test -- --passWithNoTests --silent --coverage",
        "test:ci": "lerna run test:ci -- --passWithNoTests --silent --coverage --runInBand",
        "release": "lerna version",
        "prepare": "husky",
        "prerelease": "lerna version prerelease --preid next",
        "publish": "lerna publish from-git --yes --npm-client pnpm",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "commit": "git-cz",
        "pre-commit": "lint-staged",
        "pre-push": "pnpm run test",
        "upgrade-pnpm": "corepack up",
        "upgrade-dependencies": "pnpm dlx npm-check-updates -u --target minor --reject pnpm && pnpm exec lerna exec -- pnpm dlx npm-check-updates -u --target minor && pnpm i"
    },
    "lint-staged": {
        "**/{src,test}/**/*.ts": [
            "pnpm run lint:fix"
        ]
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/@digitalroute/cz-conventional-changelog-for-jira"
        }
    },
    "devDependencies": {
        "@aws-sdk/types": "^3.862.0",
        "@commitlint/cli": "^20.4.3",
        "@commitlint/config-conventional": "^20.4.3",
        "@digitalroute/cz-conventional-changelog-for-jira": "^8.0.1",
        "@types/aws-lambda": "^8.10.152",
        "@types/jest": "^30.0.0",
        "@types/node": "~22.19",
        "aws-sdk-client-mock": "^4.1.0",
        "aws-sdk-client-mock-jest": "^4.1.0",
        "commitizen": "^4.3.1",
        "commitlint-plugin-function-rules": "^4.0.0",
        "cz-conventional-changelog": "^3.3.0",
        "esbuild": "^0.27.0",
        "husky": "^9.1.7",
        "hygen": "^6.2.11",
        "jest": "^30.2.0",
        "jest-config": "^30.2.0",
        "lerna": "^9.0.5",
        "lint-staged": "^16.2.6",
        "rimraf": "^6.1.0",
        "ts-jest": "^29.4.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    },
    "engines": {
        "node": "^22.22.1",
        "pnpm": "^10.22.0",
        "npm": "packageManager"
    },
    "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70"
}
